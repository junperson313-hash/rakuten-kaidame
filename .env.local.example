# Google Analytics 4 測定ID（未設定でもサイトは正常動作します）
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 本番公開URL（sitemap.xml / robots.txt / OGPタグに使用）
NEXT_PUBLIC_SITE_URL=https://rakuten-kaidame.vercel.app

# 楽天アフィリエイトID（未設定でもサイトは正常動作します。設定すると全商品リンクが自動でアフィリエイトリンクになります）
# 例: 1a2b3c4d.5e6f7g8h
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=
